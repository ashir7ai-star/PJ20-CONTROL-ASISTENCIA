{
  "name": "pj20-control-asistencia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pj20/backend --filter @pj20/app dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "pnpm --filter @pj20/backend test:integration",
    "dev:movil": "pnpm --filter @pj20/app dev --host",
    "db:migrate": "pnpm --filter @pj20/backend db:migrate",
    "db:usuario-app": "pnpm --filter @pj20/backend db:usuario-app",
    "admin:crear": "pnpm --filter @pj20/backend admin:crear"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
