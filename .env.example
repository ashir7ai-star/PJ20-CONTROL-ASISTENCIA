# ───────────────────────────────────────────────────────────────
# PJ20 — Variables de entorno (plantilla)
# Copia este archivo como .env y reemplaza TODOS los valores "change-me".
# .env NUNCA se sube a Git. En Easypanel se configuran en cada servicio.
# Genera secretos con:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ───────────────────────────────────────────────────────────────

# ── Servicios locales (docker-compose) ─────────────────────────
POSTGRES_USER=pj20
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pj20
REDIS_PASSWORD=change-me

# ── Backend ────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=4400
LOG_LEVEL=info
# Orígenes autorizados a llamar a la API, separados por coma
APP_ORIGINS=http://localhost:5173

# Deben coincidir con las credenciales de arriba
DATABASE_URL=postgres://pj20:change-me@localhost:15432/pj20
REDIS_URL=redis://:change-me@localhost:16379

# Almacenamiento S3 (RustFS) para selfies
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=pj20-selfies
