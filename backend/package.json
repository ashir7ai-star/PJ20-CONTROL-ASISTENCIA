{
  "name": "@pj20/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@pj20/shared": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
